<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <IssueDef>
    <defName>RFS_UrineConsumption</defName>
    <label>urine consumption</label>
    <iconPath>UI/Genes/UG_FecalWalls</iconPath>
  </IssueDef>
  <PreceptDef>
    <defName>RFS_UrineDisapproved</defName>
    <issue>RFS_UrineConsumption</issue>
    <label>disapproved</label>
    <impact>Medium</impact>
    <displayOrderInIssue>0</displayOrderInIssue>
    <description>Consuming urine is considered disapproved by this ideology.</description>
    <modExtensions>
      <li Class="Umrae.UsefulGenes.WasteBeliefExtension">
        <resource>UrineBottle</resource>
        <thought>RFS_UrineDisapprovedThought</thought>
      </li>
    </modExtensions>
  </PreceptDef>
  <ThoughtDef>
    <defName>RFS_UrineDisapprovedThought</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>consumed urine</label>
        <description>I consumed urine, which my beliefs regard as disapproved.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <PreceptDef>
    <defName>RFS_UrineAcceptable</defName>
